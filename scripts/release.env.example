# Copy outside the repository, e.g. ~/.config/checky/release.env; chmod 600.
# Load explicitly: set -a; source ~/.config/checky/release.env; set +a
ASC_KEY_ID=YOUR_APP_STORE_CONNECT_KEY_ID
ASC_ISSUER_ID=YOUR_APP_STORE_CONNECT_ISSUER_ID
ASC_KEY_FILE="$HOME/.config/checky/AuthKey_YOUR_KEY_ID.p8"
GOOGLE_PLAY_JSON_KEY="$HOME/.config/checky/google-play-service-account.json"

# Optional build defaults (normally pass version arguments to the script).
# API_BASE_URL=https://favis.vercel.app
# KAKAO_NATIVE_APP_KEY=YOUR_KAKAO_NATIVE_APP_KEY
