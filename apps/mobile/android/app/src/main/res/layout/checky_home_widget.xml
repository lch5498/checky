<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_content"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/checky_home_widget_background"
    android:orientation="horizontal" android:padding="10dp">
    <LinearLayout android:id="@+id/widget_schedule_section"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/widget_schedule_heading"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="오늘 일정" android:textSize="12sp"
            android:textColor="#FF146159" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end"
            android:includeFontPadding="false" android:layout_marginBottom="4dp" />
        <LinearLayout android:id="@+id/widget_schedule_list"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="vertical" />
    </LinearLayout>
    <!-- Use a RemoteViews-supported TextView for the divider. -->
    <TextView android:id="@+id/widget_section_divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="0dp"
        android:background="#FFC2E2DC" />
    <LinearLayout android:id="@+id/widget_parking_section"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/widget_parking_heading"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="주차 위치" android:textSize="12sp"
            android:textColor="#FF146159" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end"
            android:includeFontPadding="false" android:layout_marginBottom="4dp" />
        <LinearLayout android:id="@+id/widget_parking_list"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
