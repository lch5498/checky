<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="3dp">
    <ImageView android:id="@+id/widget_item_background"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/checky_home_widget_event_background" android:scaleType="fitXY"
        android:importantForAccessibility="no" android:contentDescription="@null" />
    <TextView android:id="@+id/widget_item_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2" android:ellipsize="end"
        android:gravity="center_vertical" android:includeFontPadding="false"
        android:minHeight="34dp" android:paddingHorizontal="5dp" android:paddingVertical="4dp"
        android:textColor="#FF142E29" android:textSize="9sp" android:textStyle="bold" />
</FrameLayout>
